{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "groundgame-support-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "kv_namespaces": [
    {
      "binding": "SUPPORT_STATE",
      "id": "c1cd109c1b3f424f98dd2178d394b642"
    }
  ],
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}